# ---------------------------------------------------------------------------
# Site identity
# ---------------------------------------------------------------------------

# Canonical origin used for metadata, Open Graph, sitemap and robots.
# Required in production. Falls back to http://localhost:3000 locally.
NEXT_PUBLIC_SITE_URL=https://www.northgatelabs.space

# Contact address shown in the footer, on /privacy and /terms, and used for
# the form's reply address. Required.
CONTACT_EMAIL=admin@northgatelabs.space

# ---------------------------------------------------------------------------
# Analytics (off by default, set to 1 on Vercel to opt in)
# ---------------------------------------------------------------------------

ENABLE_VERCEL_ANALYTICS=0

# ---------------------------------------------------------------------------
# Early access form backend
# ---------------------------------------------------------------------------
# The signup endpoint saves every submission for real and shows success only
# after the write succeeds. Pick ONE of the two options below.

# ---------------------------------------------------------------------------
# Option 1 (recommended): save in DynamoDB
# ---------------------------------------------------------------------------
DYNAMODB_TABLE_NAME=northgate-early-access

# Region used by the DynamoDB client.
AWS_REGION=us-west-2

# Credentials: on Vercel prefer OIDC. Locally, access keys are fine.
# AWS_ROLE_ARN=arn:aws:iam::123456789012:role/northgate-labs-site
# AWS_ACCESS_KEY_ID=AKIA...
# AWS_SECRET_ACCESS_KEY=...
# AWS_PROFILE=northgate-labs

# ---------------------------------------------------------------------------
# Option 2 (fallback): one email to CONTACT_EMAIL through Resend
# ---------------------------------------------------------------------------
# Works on Vercel without AWS. Create the key at resend.com/api-keys.
# RESEND_API_KEY=re_...
# Optional; defaults to Resend's verified onboarding sender.
# RESEND_FROM_ADDRESS="Northgate Labs <admin@northgatelabs.space>"
