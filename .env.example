# ---------------------------------------------------------------------------
# Site identity
# ---------------------------------------------------------------------------

# Canonical origin used for metadata, Open Graph, sitemap and robots.
# TODO: replace with your real domain before launch.
NEXT_PUBLIC_SITE_URL=https://fieldline.ag

# Public contact address shown in the footer.
# TODO: replace with your real inbox.
NEXT_PUBLIC_CONTACT_EMAIL=hello@fieldline.ag

# Public profile links shown in the footer.
# TODO: replace with your real profiles.
NEXT_PUBLIC_GITHUB_URL=https://github.com/example/fieldline
NEXT_PUBLIC_LINKEDIN_URL=https://www.linkedin.com/company/example

# ---------------------------------------------------------------------------
# Analytics (off by default, set to 1 on Vercel to opt in)
# ---------------------------------------------------------------------------

ENABLE_VERCEL_ANALYTICS=0

# ---------------------------------------------------------------------------
# Early access form backend
# ---------------------------------------------------------------------------
# If these are missing the API runs in mock mode: it logs the submission to the
# server console and returns success, so the repo runs locally with zero setup.

# DynamoDB table that stores early access signups.
# See README for the table definition.
DYNAMODB_TABLE_NAME=fieldline-early-access

# Region used by the DynamoDB and SES clients.
AWS_REGION=us-west-2

# From address for the confirmation email. Must be a verified identity in SES.
SES_FROM_ADDRESS=earlyaccess@fieldline.ag

# ---------------------------------------------------------------------------
# AWS credentials. Pick ONE of the options below.
# Recommended on Vercel: OIDC federation with AWS_ROLE_ARN (no long lived keys).
# Fallback: long lived access keys (fine for local development only).
# ---------------------------------------------------------------------------

# Option 1 (recommended): role assumed through OIDC / web identity.
# AWS_ROLE_ARN=arn:aws:iam::123456789012:role/fieldline-site

# Option 2 (fallback): access keys.
# AWS_ACCESS_KEY_ID=AKIA...
# AWS_SECRET_ACCESS_KEY=...

# Option 3 (local only): named profile from ~/.aws/credentials.
# AWS_PROFILE=fieldline
